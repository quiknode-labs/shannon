# CLI package (runs on host, not in container)
# Keep apps/cli/package.json so pnpm workspaces resolve
apps/cli/src/
**/dist/
apps/cli/infra/
apps/cli/tsconfig.json
apps/cli/tsdown.config.ts

# Docker files (avoid recursive copying)
Dockerfile*
docker-compose*.yml
.dockerignore

# Prompt files for externally-supplied vulnerability classes (see .gitignore
# for the same list). These must never be baked into the built image either —
# they're supplied at container-run time via the promptsDir bind mount, which
# always shadows this path regardless, but keeping the build context clean
# too means the image itself never carries this content under any path.
apps/worker/prompts/*prompt_injection*
apps/worker/prompts/*plugin_design*
apps/worker/prompts/*info_disclosure*
apps/worker/prompts/*output_handling*
apps/worker/prompts/*prompt_leakage*
apps/worker/prompts/*vector_weaknesses*
apps/worker/prompts/*unbounded_consumption*
apps/worker/prompts/*crypto_failures*
apps/worker/prompts/*security_misconfiguration*
apps/worker/prompts/*insecure_deserialization*
apps/worker/prompts/pipeline-testing/*prompt_injection*
apps/worker/prompts/pipeline-testing/*plugin_design*
apps/worker/prompts/pipeline-testing/*info_disclosure*
apps/worker/prompts/pipeline-testing/*output_handling*
apps/worker/prompts/pipeline-testing/*prompt_leakage*
apps/worker/prompts/pipeline-testing/*vector_weaknesses*
apps/worker/prompts/pipeline-testing/*unbounded_consumption*
apps/worker/prompts/pipeline-testing/*crypto_failures*
apps/worker/prompts/pipeline-testing/*security_misconfiguration*
apps/worker/prompts/pipeline-testing/*insecure_deserialization*

# Test files
test/
tests/
spec/
coverage/

# Documentation (except CLAUDE.md which is needed)
docs/
README.md
LICENSE
CHANGELOG.md